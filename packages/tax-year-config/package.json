{
  "name": "@ghimtech/tax-year-config",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned per-tax-year rule configuration for GhimTech Tax engines",
  "author": "Durga Ghimeray",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ghimtech/tax-domain": "workspace:*"
  },
  "devDependencies": {
    "@ghimtech/config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
