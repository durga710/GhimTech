{
  "name": "ghimtech",
  "version": "1.0.0",
  "private": true,
  "author": "Durga Ghimeray",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @ghimtech/web build",
    "dev": "pnpm --filter @ghimtech/web dev",
    "start": "pnpm --filter @ghimtech/web start",
    "lint": "eslint apps/web/src",
    "typecheck": "pnpm --filter @ghimtech/web typecheck",
    "test": "node --test apps/web/tests/*.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yml,yaml,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yml,yaml,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.21.0",
    "typescript": "^5.7.3",
    "@next/eslint-plugin-next": "^15.5.24"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
