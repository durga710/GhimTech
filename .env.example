# GhimTech Tax — environment template
# Copy to .env for local development. NEVER commit real secrets.
# See docs/environment.md for the full reference.

# ---- Core ----
GHIMTECH_ENV=development            # development | test | staging | production
PORT=4000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
GHIMTECH_CORS_ORIGIN=http://localhost:3000

# ---- Encryption keys (REQUIRED outside development) ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In staging/production these come from the secret manager, never from files.
GHIMTECH_MASTER_KEY=
GHIMTECH_INDEX_KEY=

# ---- Database ----
# Local: docker compose up postgres
DATABASE_URL=postgresql://ghimtech:ghimtech_dev@localhost:5432/ghimtech_tax
# Set GHIMTECH_STORE=memory to run the API without Postgres (development only).
#GHIMTECH_STORE=memory

# ---- Redis / queues ----
REDIS_URL=redis://localhost:6379
GHIMTECH_API_URL=http://localhost:4000
# Service-account token for the worker (create a dedicated PREPARER-role service user).
GHIMTECH_WORKER_TOKEN=

# ---- E-file provider ----
# mock | sandbox | column-tax | april | generic
# Real transmitter adapters refuse to run until implemented against official
# provider contracts — see docs/efile-providers.md.
GHIMTECH_EFILE_PROVIDER=mock

# ---- Sessions ----
GHIMTECH_SESSION_TTL_MINUTES=30
