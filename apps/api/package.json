    "@ghimtech/security": "workspace:*",
    "@ghimtech/tax-domain": "workspace:*",
    "@ghimtech/tax-engine-federal": "workspace:*",
    "@ghimtech/tax-engine-pennsylvania": "workspace:*",
    "@ghimtech/tax-year-config": "workspace:*",
    "@ghimtech/validation": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
